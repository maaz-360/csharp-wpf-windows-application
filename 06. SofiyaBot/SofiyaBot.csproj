<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- EXE Icon -->
    <ApplicationIcon>Assets\bot_flag_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="10.0.10" />
  </ItemGroup>
  
  <ItemGroup>
      <Resource Include="Assets\bot_flag_icon.ico" />
      <Resource Include="Assets\SofiaBotEquilizer.gif" />
      <Resource Include="Assets\SofiaBotEquilizer.mp4" />
  </ItemGroup>
</Project>
